{
  "任务名": "需求工程",
  "版本": 4,
  "交付物": {
    "名称": "软件需求规格说明",
    "文档模板": "docs/templates/srs.md",
    "条目集合": [
      {
        "名称": "功能用例",
        "编号前缀": "UC",
        "评审规矩": { "规则文件": "docs/review-rules/use-case.json", "关闭": ["UC-R15"] },
        "字段": [
          { "名": "用例名称", "类型": "文本", "必填": true },
          { "名": "用例功能", "类型": "文本", "必填": true },
          { "名": "参与者", "类型": "文本列表", "必填": true },
          { "名": "前置条件", "类型": "文本列表", "必填": false },
          { "名": "后置条件", "类型": "文本列表", "必填": false },
          { "名": "约束规则", "类型": "文本列表", "必填": false },
          { "名": "基本流程", "类型": "文本列表", "必填": true },
          { "名": "扩展流程", "类型": "文本列表", "必填": false }
        ]
      },
      {
        "名称": "非功能需求",
        "编号前缀": "NFR",
        "评审规矩": { "规则文件": "docs/review-rules/ears.json", "关闭": ["EARS-R10"] },
        "字段": [
          { "名": "类别", "类型": "文本", "必填": true },
          { "名": "句式类型", "类型": "枚举", "必填": true,
            "取值": ["普遍型", "事件驱动型", "状态驱动型", "可选特性型", "异常处理型", "复合型"] },
          { "名": "需求语句", "类型": "文本", "必填": true }
        ]
      },
      {
        "名称": "约束",
        "编号前缀": "CON",
        "评审规矩": { "规则文件": "docs/review-rules/ears.json", "关闭": ["EARS-R10"] },
        "字段": [
          { "名": "类别", "类型": "文本", "必填": true },
          { "名": "句式类型", "类型": "枚举", "必填": true,
            "取值": ["普遍型", "事件驱动型", "状态驱动型", "可选特性型", "异常处理型", "复合型"] },
          { "名": "需求语句", "类型": "文本", "必填": true }
        ]
      },
      {
        "名称": "问题",
        "编号前缀": "TBD",
        "字段": [
          { "名": "事项", "类型": "文本", "必填": true },
          { "名": "种类", "类型": "枚举", "必填": true, "取值": ["待澄清", "范围外", "后续迭代"] },
          { "名": "是否阻断下游", "类型": "枚举", "必填": true, "取值": ["阻断下游", "不阻断"] },
          { "名": "何时回看", "类型": "文本", "必填": false },
          { "名": "建议的处理", "类型": "文本", "必填": false },
          { "名": "状态", "类型": "枚举", "必填": true, "取值": ["未解决", "已解决", "用户决定保留"] },
          { "名": "处理结果", "类型": "文本", "必填": false },
          { "名": "落实到", "类型": "文本", "必填": false },
          { "名": "关联条目", "类型": "条目引用", "必填": false }
        ]
      },
      {
        "名称": "总体分析",
        "编号前缀": "OA",
        "界面": { "右侧栏页签": true, "分组字段": "标签", "靠前的组": ["概念"], "说明": "按章整理的业务说明：每一节写它是什么、适用规则、待澄清事项，图与需求条目都归在它说明的那一节。" },
        "字段": [
          { "名": "标题", "类型": "文本", "必填": true },
          { "名": "别名", "类型": "文本列表", "必填": false },
          { "名": "它是什么", "类型": "文本", "必填": true },
          { "名": "例子", "类型": "文本列表", "必填": false },
          { "名": "已经定下的", "类型": "文本列表", "必填": false },
          { "名": "标签", "类型": "文本列表", "必填": false,
            "取值": ["概念", "角色", "流程", "场景", "目标", "范围", "假设", "决定"] },
          { "名": "上级主题", "类型": "条目引用", "必填": false, "只许本集合": true, "至多一个": true },
          { "名": "状态", "类型": "枚举", "必填": true, "取值": ["在用", "已废弃"] },
          { "名": "改看", "类型": "条目引用", "必填": false, "只许本集合": true, "至多一个": true },
          { "名": "导语所属章", "类型": "枚举", "必填": false, "取值": ["概述与范围", "角色", "业务流程", "业务对象", "业务规则", "业务目标", "决策记录与待澄清事项"] }
        ]
      }
    ],
    "每个条目附带": "来源"
  },
  "完成条件": {
    "功能用例": ["至少一个条目", "每个条目评审通过", "每个条目用户确认"],
    "非功能需求": ["每个条目评审通过", "每个条目用户确认"],
    "约束": ["每个条目评审通过", "每个条目用户确认"],
    "问题": ["没有状态为未解决的条目"],
    "总体分析": ["每个条目用户确认"]
  },
  "执行方法": ".pi/skills/requirements-engineering/SKILL.md",
  "材料目录": "inputs/",
  "领域规矩": [
    "docs/domain-knowledge/use-case-writing.md",
    "docs/domain-knowledge/ears-writing.md"
  ]
}
