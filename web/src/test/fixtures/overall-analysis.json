  {
   "item_id": "OA-003",
   "collection": "业务说明",
   "title": "预约取书",
   "revision_no": 12,
   "revision_by": "executor",
   "revision_at": "2026-10-08T10:43:00+08:00",
   "revisions": [
    9,
    12
   ],
   "fields": {
    "标题": "预约取书",
    "别名": [
     "预约"
    ],
    "它是什么": "读者对一本在架的书办预约，馆员把这本书从书架取下，放到预留架上等读者来取。书放在预留架的这段时间叫保留期，保留期是 3 天，过了没来取，书放回书架，让给下一位。\n\n它与排队等书不是一回事：书还在别人手上时，读者登记的是排队，等书还回来才转成预约取书。",
    "例子": [
     "小王周六在家预约了《算法导论》，当时书在架上。周一馆员把书放到预留架，小王周二来取，办了借阅。",
     "反例：小李想借的《深入理解计算机系统》还在别人手上，他登记的是排队等书，不是预约取书。"
    ],
    "已经定下的": [
     "只有在架的书才能预约取书。",
     "一本书同一时间只能被一个人预约。",
     "保留期内这本书不能被别人借走，也不能续借给原借阅人。",
     "保留期是 3 天。"
    ],
    "标签": [
     "概念",
     "流程"
    ],
    "上级主题": [
     "OA-001"
    ],
    "状态": "在用",
    "改看": []
