   "fields": {
    "标题": "借书与还书",
    "别名": [],
    "它是什么": "读者拿着书和借书证到自助借还机或服务台，系统核对借书证与还能借几本，登记借出和应还日期；还书时系统登记归还。读者也可以对在架的书办预约取书，馆员把书放到预留架。",
    "例子": [
     "学生小陈周三下午在自助借还机上借了两本书，应还日期是 30 天后的周五。"
    ],
    "已经定下的": [
     "学生一次最多借 5 本。",
     "教师一次最多借 10 本。",
     "借期都是 30 天。",
     "借书和还书都可以在自助借还机上办，也可以到服务台办。",
     "名下有逾期未还图书的读者不能再借。"
    ],
    "标签": [
     "流程"
    ],
    "上级主题": [
